COMPOSE_PROJECT_NAME=call-reservation
MONGODB_PORT=27017
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=reservation
RABBITMQ_DEFAULT_PASS=reservation
RABBITMQ_DEFAULT_VHOST=call-reservation
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
CALL_REQUESTS_SERVICE_PORT=3001
WEB_SERVICE_PORT=4200
JWT_SECRET=replace-with-a-secret-that-is-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGIN=http://localhost:4200
SMTP_FROM=no-reply@call-reservation.local
